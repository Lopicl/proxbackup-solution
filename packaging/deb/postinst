#!/bin/sh
# Sets up ProxBackup Console on this Proxmox Backup Server:
#   - a system user "proxbackup" the service runs as
#   - a PBS user proxbackup@pbs, which the console signs in as and which owns
#     the agents' API tokens (password in /etc/proxbackup/pbs-password). It gets
#     rights only on the root namespaces of the datastores added to the console,
#     from proxbackup-server-grants.service
#   - proxbackup-server-grants.path, which applies the rights the console asks for
#   - /etc/proxbackup/proxbackup.env with this host's names (kept on upgrades)
#   - the proxbackup-server service on port 8077
#   - proxbackup-server-update.path, which installs updates the console requests
set -e

CONF=/etc/proxbackup
PW_FILE=$CONF/pbs-password
ENV_FILE=$CONF/proxbackup.env
PBS_USER=proxbackup@pbs
PORT=8077

[ "$1" = configure ] || exit 0

if ! command -v proxmox-backup-manager >/dev/null 2>&1; then
	echo "proxbackup-server: proxmox-backup-manager not found; install this package on a Proxmox Backup Server." >&2
	exit 1
fi

if ! getent passwd proxbackup >/dev/null; then
	useradd --system --user-group --home-dir /var/lib/proxbackup --no-create-home \
		--shell /usr/sbin/nologin --comment "ProxBackup Console" proxbackup
fi
install -d -m 0750 -o root -g proxbackup "$CONF"

# The console provisions namespaces, tokens and their ACLs for each PC as
# $PBS_USER. Without Permissions.Modify it can set ACLs only for its own
# tokens, and PBS caps those at the user's privileges.
# Its own ACLs are set by proxbackup-server-grants.service: it asks for them
# at startup, and the rights of older packages (DatastoreAdmin on /datastore)
# stay until then.
if ! proxmox-backup-manager user list --output-format json | grep -qF "\"userid\":\"$PBS_USER\""; then
	proxmox-backup-manager user create "$PBS_USER" --comment "ProxBackup Console and its agents"
fi
if [ ! -s "$PW_FILE" ]; then
	pw=$(head -c 32 /dev/urandom | base64 | tr -d '/+=\n')
	(umask 077 && printf '%s\n' "$pw" > "$PW_FILE.new")
	# PBS takes a password only as an argument (shown to local users by ps
	# while this runs); API tokens can't set it.
	proxmox-backup-debug api set /access/password --userid "$PBS_USER" --password "$pw" >/dev/null
	mv "$PW_FILE.new" "$PW_FILE"
fi
chown root:proxbackup "$PW_FILE"
chmod 0640 "$PW_FILE"
# Packages up to 0.2.16 used a root@pam token with Admin on / instead.
proxmox-backup-manager user delete-token root@pam proxbackup-console >/dev/null 2>&1 || true
rm -f "$CONF/pbs-token"

if [ ! -f "$ENV_FILE" ]; then
	fqdn=$(hostname -f 2>/dev/null || hostname)
	short=$(hostname -s 2>/dev/null || hostname)
	ips=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^$' | grep -v '^fe80' | paste -sd, - || true)
	hosts=$(printf '%s\n' "$fqdn" "$short" localhost | awk '!seen[$0]++' | paste -sd, -)
	[ -n "$ips" ] && hosts="$hosts,$ips"
	(umask 077 && cat > "$ENV_FILE" <<EOF
# ProxBackup Console settings, read by proxbackup-server.service.
# After editing: systemctl restart proxbackup-server

# URL the PCs (agents) use to reach this console. Its host name must be listed
# in PROXBACKUP_HOSTNAMES (the console's certificate is issued for those).
PROXBACKUP_PUBLIC_URL=https://$fqdn:$PORT
PROXBACKUP_HOSTNAMES=$hosts

# Web UI and agent API (comma separated for several addresses).
PROXBACKUP_LISTEN=:$PORT

# Running on this PBS: its datastores can be added without credentials.
PROXBACKUP_LOCAL_PBS=1
# PBS address the agents back up to (default: host of PROXBACKUP_PUBLIC_URL, port 8007).
#PROXBACKUP_PBS_PUBLIC_HOST=$fqdn:8007

# GitHub repository automatic updates come from (schedule: Settings -> Updates).
#PROXBACKUP_UPDATE_REPO=Lopicl/proxbackup-solution
EOF
	)
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload
	systemctl enable proxbackup-server.service >/dev/null 2>&1
	systemctl enable --now proxbackup-server-update.path >/dev/null 2>&1
	systemctl enable --now proxbackup-server-grants.path >/dev/null 2>&1
	systemctl restart proxbackup-server.service
fi

url=$(sed -n 's/^PROXBACKUP_PUBLIC_URL=//p' "$ENV_FILE")
cat <<EOF

ProxBackup Console: $url
Sign in as "admin". On a new install its initial password is in:
  journalctl -u proxbackup-server
Add more users and roles under Users. PBS accounts can't sign in to the console.

EOF
exit 0
