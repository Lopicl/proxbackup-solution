#!/usr/bin/env bash
# Every commit is a build: bump BUILD and TOTAL unless VERSION is already part
# of this commit (e.g. after `scripts/version.sh minor` or a manual bump).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
if git diff --cached --quiet -- VERSION 2>/dev/null && git rev-parse --verify -q HEAD >/dev/null; then
  v=$("$root/scripts/version.sh" build)
  git add "$root/VERSION"
  echo "pre-commit: version bumped to $v"
fi
